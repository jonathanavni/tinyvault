{
  "name": "tinyvault",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node --experimental-import-meta-resolve scripts/check-dependency-boundary.mjs && node --experimental-import-meta-resolve scripts/dependency-boundary.selftest.mjs && vitest run",
    "eval": "TINYVAULT_EVAL=1 vitest run testbed/runner.eval.test.ts --reporter=verbose",
    "baseline": "node -e \"console.error('not implemented until M6'); process.exit(1)\"",
    "demo": "node -e \"console.error('not implemented until M10'); process.exit(1)\""
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
